# TaxiWeb client — environment. Copy to .env.

# The client calls the API on its own origin (/api/...). In development Vite
# proxies it to VITE_DEV_API_PROXY below; in production the host forwards it
# (client/vercel.json). There is no API URL to set here.

# Optional. Only if Socket.IO runs on a different host than the site.
VITE_SOCKET_URL=

# Optional. Enables Google Places autocomplete and geocoding for arbitrary
# addresses. Without it the booking form falls back to the built-in list of
# known local places — it never invents coordinates.
VITE_GOOGLE_MAPS_API_KEY=

# Dev-server proxy target. Only used by vite.config.js during `npm run dev`.
VITE_DEV_API_PROXY=http://localhost:5000
