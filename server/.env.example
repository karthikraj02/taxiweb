# ─────────────────────────────────────────────────────────────────────────────
# TaxiWeb API — environment
#
# Copy to .env and fill in. NEVER commit .env.
# In production the process REFUSES TO START if a required value is missing —
# there are no development fallbacks for secrets.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ── Database (required) ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/taxiweb?retryWrites=true&w=majority

# ── Secrets (required in production, min 32 chars) ───────────────────────────
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=
CSRF_SECRET=

JWT_EXPIRES_IN=15m
DRIVER_JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ── CORS (PHASE 52) ──────────────────────────────────────────────────────────
# No deployment URL is hardcoded anywhere in the source.
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=

# ── OTP policy (PHASE 4) ─────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Routing / distance (PHASE 10) ────────────────────────────────────────────
# google | osrm | haversine
#   google    — needs GOOGLE_MAPS_API_KEY with Distance Matrix enabled
#   osrm      — public demo server or your own OSRM instance
#   haversine — geometric ESTIMATE only. Usable for development; responses are
#               explicitly flagged as estimated. Not recommended for production.
ROUTING_PROVIDER=haversine
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
HAVERSINE_ROAD_FACTOR=1.3
ROUTING_TIMEOUT_MS=5000

# ── Payments (required in production) ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard → Settings → Webhooks. Required in production.
RAZORPAY_WEBHOOK_SECRET=

# ── Pricing (all optional; defaults shown) ───────────────────────────────────
PRICE_ETIOS_BASE=600
PRICE_ETIOS_RATE=12
PRICE_ETIOS_MIN_KM=50
PRICE_DZIRE_BASE=650
PRICE_DZIRE_RATE=13
PRICE_DZIRE_MIN_KM=50
PRICE_INNOVA_BASE=1100
PRICE_INNOVA_RATE=18
PRICE_INNOVA_MIN_KM=61
PRICE_TEMPO_BASE=2500
PRICE_TEMPO_RATE=25
PRICE_TEMPO_MIN_KM=100
PRICE_ROUND_TRIP_MULTIPLIER=1.9
PRICE_NIGHT_SURCHARGE_PERCENT=10
PRICE_NIGHT_START_HOUR=22
PRICE_NIGHT_END_HOUR=5
PRICE_AIRPORT_SURCHARGE=150
PRICE_TAX_PERCENT=5
PRICE_MAX_DISTANCE_KM=2000

# ── Dispatch (PHASE 19) ──────────────────────────────────────────────────────
DISPATCH_RADIUS_METERS=15000
DISPATCH_MAX_CANDIDATES=10

# ── SMS (Twilio) — OTP delivery for customers ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional — without this, password-reset emails are logged instead of sent.
# Get a free key at https://resend.com (no domain verification needed to send
# from onboarding@resend.dev).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── Demo mode (PHASE 3/12) ───────────────────────────────────────────────────
# Forced to false whenever NODE_ENV=production, regardless of this value.
DEMO_MODE=false

# ── Admin provisioning ───────────────────────────────────────────────────────
# Used by: npm run seed:admin
ADMIN_EMAIL=
